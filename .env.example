# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Accounts + sync are OFF unless a sign-in provider, a secret and a database
# are all configured. The app works fully without any of this.

# Session secret, at least 32 characters. Generate with: openssl rand -base64 32
# Required in production. In development a fixed, publicly known fallback is used when
# it is UNSET (accounts then work on http://localhost only). A value that is set but
# shorter than 32 characters turns accounts + sync off, in development too.
NEXTAUTH_SECRET=

# Public base URL of the site, e.g. http://localhost:3000 locally. On Vercel it can be
# left unset (the deployment host is used); set it to the canonical https URL if you have one.
NEXTAUTH_URL=

# GitHub OAuth app: github.com > Settings > Developer settings > OAuth Apps.
# Callback URL: <site origin>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Google OAuth client (type "Web application"): console.cloud.google.com >
# Google Auth Platform > Clients (formerly APIs & Services > Credentials).
# Redirect URI: <site origin>/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# Postgres connection string. On Vercel the Neon integration (Storage tab) injects it;
# POSTGRES_URL is accepted as a fallback. Run `yarn db:migrate` once after setting it.
# Unset in development = a local PGlite database in LL_PGLITE_DIR.
# CAREFUL: scripts/db.mjs (yarn db:migrate, db:dump, and `reset`) and `yarn dev` both
# read DATABASE_URL from this file. Do not leave a production URL here.
DATABASE_URL=

# Development only: set to 1 to enable the passwordless "dev" sign-in. Ignored in
# production builds and on Vercel (the code is not even in the production bundle).
# WARNING: anyone who can reach your dev server can then sign in as any user, and
# `next dev` listens on all network interfaces. NEVER enable this on a machine other
# people can reach; consider `yarn dev -H 127.0.0.1`. (The dev login only answers
# requests whose Host is localhost, but that check is not a network access control.)
AUTH_DEV_LOGIN=

# Development only: directory of the local PGlite database (default .data/pglite).
LL_PGLITE_DIR=

# Optional: Next.js build directory (default .next), for running several servers side by side.
NEXT_DIST_DIR=

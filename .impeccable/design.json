      "css": ".ds-leader{position:relative;width:220px;height:90px;color:var(--line,#f2f6ff)}.ds-leader svg{position:absolute;inset:0}.ds-leader-label{position:absolute;left:100px;top:0;display:inline-flex;align-items:center;gap:6px;height:28px;padding-left:6px;font-family:var(--font-display,'Josefin Sans',sans-serif);font-weight:600;font-size:11px;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}.ds-sw{width:10px;height:10px;border:1px solid var(--line,#f2f6ff);background:var(--finger-3,#3fe0d0)}.ds-leader-label b{color:var(--sub,#bdd2f4);font-weight:600}"

  "narrative": {
    "northStar": "The Living Drawing",
    "overview": "The app is an engineering drawing of hands on a keyboard. The drawing sheet is the page and the hands are the plate at its centre. It is drafted twice: Blueprint (dark cyanotype, chalk linework, safety-yellow action) and Whiteprint (light drafting paper, blue ink, red-pencil action). Everything is square, ruled and lettered; depth comes from line weight and fill, never shadow.",
    "keyCharacteristics": [
      "Square corners everywhere (radius 0); depth comes from line weight and fill, never shadow.",
      "One action colour per theme.",
      "Josefin Sans tracked capitals for lettering, Barlow Semi Condensed for UI, IBM Plex Mono for typed text and numbers.",
      "A 10px drafting grid with a heavier line every 50px on every page.",
      "Ten finger colours on keys and hands only."
    ],
    "rules": [
      {
        "name": "The One Action Rule",
        "body": "One saturated colour per theme carries the action. The finger colours are not actions and never decorate chrome.",
        "section": "colors"
      },
      {
        "name": "The Fingers-Only Rule",
        "body": "Finger colours appear only as fills on keys, fingertips, chips and legends.",
        "section": "colors"
      },
      {
        "name": "The Contrast Floor Rule",
        "body": "Text and sub are at least 4.5:1 on the sheet and raised fills; --border at least 3:1; --finger-fg at least 4.5:1 on every finger fill.",
        "section": "colors"
      },
      {
        "name": "The Lettered Caps Rule",
        "body": "Display type is always uppercase and tracked.",
        "section": "typography"
      },
      {
        "name": "The Mono Is Measurement Rule",
        "body": "Anything typed, keyed or counted is Plex Mono with tabular figures.",
        "section": "typography"
      },
      {
        "name": "The No-Shadow Rule",
        "body": "A surface is separated by a rule or a fill step, never a shadow.",
        "section": "elevation"
      },
      {
        "name": "The Hatch Means Pending Rule",
        "body": "135-degree hatching means busy or not there yet, and nothing else.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do re-value tokens under [data-theme] for any new colour, in both Blueprint and Whiteprint, and check the contrast floor.",
      "Do use the type utilities (ll-title, ll-heading, ll-lettering*, ll-readout, ll-numeral, ll-note) instead of ad-hoc sizes.",
      "Do use ll-trim on single-line caps inside fixed-height controls.",
      "Do show state with line style: dashed means disabled, hatched means busy or pending, thicker means selected or measured.",
      "Do use --text rather than --sub for text on --key-bg in Blueprint.",
      "Do draw legends after the hand passes, with a cap-coloured halo, so hands never cross them."
    ],
    "donts": [
      "Don't add shadows, glows, gradients or rounded corners.",
      "Don't use finger colours for chrome, status or decoration.",
      "Don't set display type in lowercase or untracked, or use a system display face.",
      "Don't hide key legends behind hands or overlays.",
      "Don't build new surfaces as dark-slate cards with a neon accent.",
      "Don't light the 3D scene, add shadows, or give the hands an opaque fill."
    ]
  }
}